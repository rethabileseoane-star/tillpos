# Production builds enforce licensing.
#
# `npm run dev` stays dormant so the till opens without a licence server or a
# key while you are working on it. `npm run build` (what Cloudflare Pages runs)
# loads this file and turns the gate on.
#
# Rollback: delete this line, push, and every install is unlocked again on its
# next check-in. Do not do that while clients are paying.
VITE_LICENSE_DORMANT=false
