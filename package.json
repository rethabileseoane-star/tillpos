{
  "name": "tillpos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "npm run test:unit && npm run test:int && npm run test:sync",
    "test:unit": "esbuild tools/smoke.ts --bundle --platform=node --format=esm --tsconfig=./tsconfig.app.json --outfile=tools/.smoke.mjs --log-level=warning && node tools/.smoke.mjs",
    "test:int": "esbuild tools/itest.ts --bundle --platform=node --format=cjs --tsconfig=./tsconfig.app.json --outfile=tools/.itest.cjs --log-level=warning && node tools/.itest.cjs",
    "test:sync": "esbuild tools/syncstub.ts --bundle --platform=node --format=cjs --tsconfig=./tsconfig.app.json --outfile=tools/.syncstub.cjs --log-level=warning && node tools/.syncstub.cjs",
    "icons": "node tools/make-icons.mjs",
    "cert": "node tools/make-cert.mjs",
    "dev:https": "cross-env TILL_HTTPS=1 vite",
    "preview:https": "cross-env TILL_HTTPS=1 vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^4.4.0",
    "jspdf": "^2.5.1",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "xlsx": "^0.18.5",
    "zxing-wasm": "^2.2.0"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.12",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.4.49",
    "selfsigned": "^5.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
